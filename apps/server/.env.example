# Local development values. Copy to .env: `cp .env.example .env`
# Start the database first: docker compose -f compose.yaml -f compose.dev.yaml up -d db
DATABASE_URL="postgresql://game:local-demo-only@localhost:5434/drawing_game"
PORT=3000
# The browser origin. In development that is the Vite dev server, which
# proxies /api and /socket.io to this server.
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info
# Lower to 2 for quick solo testing; the game rules default to 3.
MIN_PLAYERS_TO_START=3
# Skip Prisma CLI update checks (slow and noisy).
CHECKPOINT_DISABLE=1
